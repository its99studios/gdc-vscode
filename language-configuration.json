{
	"comments": {
		"lineComment": "#"
	},
	"autoClosingPairs": [
		{
			"open": "\"",
			"close": "\""
		},
		{
			"open": "'",
			"close": "'"
		}
	],
	"surroundingPairs": [
		{
			"open": "\"",
			"close": "\""
		},
		{
			"open": "'",
			"close": "'"
		}
	],
	"indentationRules": {
		"increaseIndentPattern": "^\\s*(dialogue\\s+[A-Za-z_][A-Za-z0-9_]*|choice|\".*\"|'.*'):\\s*(#.*)?$"
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*end\\s*$",
			"action": {
				"indent": "outdent"
			}
		}
	]
}