{
	"comments": {
		"lineComment": "#"
	},
	"autoClosingPairs": [
		{
			"open": "\"",
			"close": "\""
		},
		{
			"open": "'",
			"close": "'"
		}
	],
	"surroundingPairs": [
		{
			"open": "\"",
			"close": "\""
		},
		{
			"open": "'",
			"close": "'"
		}
	],
	"onEnterRules": [
		{
			"beforeText": "^\\s*dialogue\\s+[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*(?:#.*)?$",
			"action": {
				"indent": "indent"
			}
		},
		{
			"beforeText": "^\\s*choice\\s*:\\s*(?:#.*)?$",
			"action": {
				"indent": "indent"
			}
		},
		{
			"beforeText": "^\\s*(?:\".*\"|'.*'):\\s*(?:#.*)?$",
			"action": {
				"indent": "indent"
			}
		},
		{
			"beforeText": "^\\s*end\\s*$",
			"action": {
				"indent": "outdent"
			}
		}
	]
}