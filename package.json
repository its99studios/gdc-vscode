{
	"name": "gdc-vscode",
	"displayName": "GDC",
	"description": "Language support for Godot Dialogue Compositor (GDC).",
	"version": "1.0.0",
	"publisher": "its99studios",
	"icon": "images/icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Programming Languages"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/its99studios/gdc-vscode.git"
	},
	"main": "./out/extension.js",
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"contributes": {
		"languages": [
			{
				"id": "gdc",
				"aliases": [
					"GDC",
					"gdc"
				],
				"extensions": [
					".gdc"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "images/gdc_icon.png",
					"dark": "images/gdc_icon.png"
				}
			}
		],
		"grammars": [
			{
				"language": "gdc",
				"scopeName": "source.gdc",
				"path": "./syntaxes/gdc.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "gdc",
				"path": "./snippets/gdc.json"
			}
		]
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/vscode": "^1.145.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"vscode-languageclient": "^11.0.0",
		"vscode-languageserver": "^11.0.0",
		"vscode-languageserver-textdocument": "^1.0.16"
	}
}
