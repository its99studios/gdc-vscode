{
	"name": "gdc-vscode",
	"displayName": "GDC",
	"description": "Language support for Godot Dialogue Compositor (GDC).",
	"version": "1.0.0",
	"publisher": "its99studios",
	"icon": "images/icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Programming Languages"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/its99studios/gdc-vscode.git"
	},
	"contributes": {
		"languages": [
			{
				"id": "gdc",
				"aliases": [
				"GDC",
				"gdc"
				],
				"extensions": [
					".gdc"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "gdc",
				"scopeName": "source.gdc",
				"path": "./syntaxes/gdc.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "gdc",
				"path": "./snippets/gdc.json"
			}
		]
	}
}